# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in values for LOCAL DEVELOPMENT
# .env.local is gitignored — never commit real secrets
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3004

# ── Supabase (create free project at supabase.com) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=dev-secret-change-in-production-min-32-chars
NEXTAUTH_URL=http://localhost:3004
ADMIN_EMAIL=hello@wineandflow.com
ADMIN_PASSWORD_HASH=$2b$10$placeholder

# ── Stripe (use test keys from dashboard.stripe.com) ─────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ── Email / Resend (optional for local dev) ───────────────────────────────────
RESEND_API_KEY=re_placeholder
EMAIL_FROM=hello@wineandflow.com
